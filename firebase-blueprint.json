{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered ONYX GLOW customer profile stored by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "emailVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "fullName", "email", "phone", "emailVerified", "status", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Women collection item or sample placeholder in ONYX GLOW catalogue.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "Dhaka Collection",
            "Contemporary Ethnic Wear",
            "Kurta Sets",
            "Tops and Skirts",
            "Signature Collection"
          ]
        },
        "description": { "type": "string", "minLength": 2, "maxLength": 500 },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "priceLabel": { "type": "string", "maxLength": 60 },
        "availability": { "type": "string", "maxLength": 60 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "isPlaceholder": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "name", "category", "description", "sizes", "colors", "priceLabel", "availability", "imageUrl", "isPlaceholder", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Authenticated customer product order submitted through ONYX GLOW.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderReference": { "type": "string", "minLength": 6, "maxLength": 32 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "shippingAddress": { "type": "string", "minLength": 4, "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Preparing", "Shipped", "Delivered", "Cancelled"]
        },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "orderReference",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "shippingAddress",
        "items",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Authenticated customer launch event reservation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referenceNumber": { "type": "string", "minLength": 6, "maxLength": 32 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "guests": { "type": "integer" },
        "attendanceConfirmed": { "type": "boolean" },
        "message": { "type": "string", "maxLength": 600 },
        "privacyConsent": { "type": "boolean" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Cancelled", "Attended"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": [
        "id",
        "referenceNumber",
        "userId",
        "fullName",
        "email",
        "phone",
        "guests",
        "attendanceConfirmed",
        "privacyConsent",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventConfig": {
      "title": "EventConfig",
      "description": "Launch event configuration managed by ONYX GLOW administrators.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 600 },
        "date": { "type": "string", "maxLength": 80 },
        "time": { "type": "string", "maxLength": 80 },
        "venue": { "type": "string", "maxLength": 160 },
        "ticketPrice": { "type": "string", "maxLength": 60 },
        "bookingEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["title", "description", "bookingEnabled", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated customer profile documents keyed by Firebase UID."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Women collection items publicly readable and admin-writable."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer product orders owned by userId."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Launch event reservations owned by userId."
    },
    "/config/{docId}": {
      "schema": { "$ref": "#/entities/EventConfig" },
      "description": "Publicly readable event and site content configuration documents."
    }
  }
}
